; Open with Godot 4.6 .NET. The standard editor cannot load C# scripts.
config_version=5

[application]
config/name="Mordor Remastered"
run/main_scene="res://Client/Main.tscn"
config/features=PackedStringArray("4.6", "C#", "GL Compatibility")
config/icon="res://Assets/icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="MordorRemasteredPrototype"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/size/min_width=1100
window/size/min_height=720
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="MordorRemastered"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.046, 0.053, 1)
